{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --no-input && python manage.py migrate",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
